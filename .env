# Access Control Policy
# Documentation and internal resources are not publicly indexed or served

# Blocked from public indexing
PRIVATE_PATHS=/docs,/README.md

# Public paths only
PUBLIC_PATHS=/,/about,/services,/llms.txt,/robots.txt,/sitemap.xml,/404.html,/stylesheet.css,/assets

# Search engine indexing disabled for private paths
NOINDEX_PATHS=/docs,/wiki
